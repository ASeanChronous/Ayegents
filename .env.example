# Shared by services/api and services/orchestrator
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
ANTHROPIC_API_KEY=sk-ant-...
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be the SAME value in both services/api/.env and services/orchestrator/.env —
# the API encrypts tool credentials with this key, the orchestrator decrypts them.
ENCRYPTION_KEY=...

# Supabase project (apps/web and services/api)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
NEXT_PUBLIC_API_URL=http://localhost:8000
